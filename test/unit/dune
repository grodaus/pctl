; Shared fixture/temp-file helpers used by the per-module test files.
(library
 (name test_helpers)
 (modules test_helpers)
 (libraries str unix ctypes ctypes-foreign))

; Per-module unit test executables. Split out of the old monolithic
; test_pctl.ml; each file covers a single concern so the runner output
; shows the concern name in its heading.
(tests
 (names test_schema test_identity test_render test_manifest test_spec
        test_systemctl_sig test_unit_store test_probe test_gc)
 (modules test_schema test_identity test_render test_manifest test_spec
          test_systemctl_sig test_unit_store test_probe test_gc)
 (libraries schema identity render state spec systemctl unit_store
            probe gc mtime str
            eio eio_main eio.unix yojson alcotest qcheck-core qcheck-alcotest
            test_helpers)
 (deps (source_tree fixtures)))
