; e2e tests — real systemd --user.
;
; Each test is declared as an `executable` (not `test`) so `dune runtest`
; does NOT pick them up; the `e2e` alias rules below run them via
; `dune build @e2e`. This keeps them out of the Nix sandbox, which was
; not booted with systemd, and out of `nix flake check`.
;
; Tests are gated at runtime on sd_booted; without it a test prints SKIP
; and exits 0. See Harness.skip_reason.

(executable
 (name test_dbus_smoke)
 (modules test_dbus_smoke)
 (libraries e2e_harness schema systemctl eio eio_main eio.unix alcotest unix))

(library
 (name e2e_harness)
 (wrapped false)
 (modules harness reexec)
 (libraries schema identity unit_store cli spec state systemctl yojson str
            eio eio_main eio.unix alcotest unix mtime mtime.clock.os))

(executables
 (names test_up test_up_idempotent test_reload test_down test_worktree
        test_workspace test_wait_active test_wait_probe test_wait_timeout
        test_down_missing_units
        test_results test_host test_up_no_block test_up_no_wait
        test_logs test_status test_list test_gc
        test_gc_explicit test_pctl_no_gc test_dbus_subscribe
        test_depends_on_wait test_unit_state_survives_reexec
        test_reload_survives_reexec test_harness_reads)
 (modules test_up test_up_idempotent test_reload test_down test_worktree
          test_workspace test_wait_active test_wait_probe test_wait_timeout
          test_down_missing_units
          test_results test_host test_up_no_block test_up_no_wait
          test_logs test_status test_list test_gc
          test_gc_explicit test_pctl_no_gc test_dbus_subscribe
          test_depends_on_wait test_unit_state_survives_reexec
          test_reload_survives_reexec test_harness_reads)
 (libraries e2e_harness schema identity unit_store cli state systemctl yojson
            str eio eio_main eio.unix alcotest unix mtime mtime.clock.os))

; One rule, running every test in sequence, forces the serialisation dune
; would otherwise not give an alias. The races it was built for — one
; test's install step clobbering another's, every test sharing one
; XDG_RUNTIME_DIR — cannot happen to a test that owns its own manager and
; runtime dir. What still needs it is test_reload_survives_reexec; see
; test/e2e/reexec.ml. Retiring the collapse, and measuring what parallel
; actually costs, is pctl-nested-manager-harness-nak.5.

(rule
 (alias e2e)
 (deps test_dbus_smoke.exe test_harness_reads.exe test_dbus_subscribe.exe
       test_up.exe
       test_up_idempotent.exe
       test_reload.exe test_down.exe test_down_missing_units.exe
       test_worktree.exe test_workspace.exe
       test_wait_active.exe test_wait_probe.exe test_wait_timeout.exe
       test_results.exe test_host.exe test_up_no_block.exe
       test_up_no_wait.exe
       test_logs.exe test_status.exe test_list.exe test_gc.exe
       test_gc_explicit.exe test_pctl_no_gc.exe
       test_depends_on_wait.exe test_unit_state_survives_reexec.exe
       test_reload_survives_reexec.exe)
 (action
  (progn
   (run ./test_dbus_smoke.exe)
   (run ./test_harness_reads.exe)
   (run ./test_dbus_subscribe.exe)
   (run ./test_up.exe)
   (run ./test_up_idempotent.exe)
   (run ./test_reload.exe)
   (run ./test_down.exe)
   (run ./test_down_missing_units.exe)
   (run ./test_worktree.exe)
   (run ./test_workspace.exe)
   (run ./test_wait_active.exe)
   (run ./test_wait_probe.exe)
   (run ./test_wait_timeout.exe)
   (run ./test_results.exe)
   (run ./test_host.exe)
   (run ./test_up_no_block.exe)
   (run ./test_up_no_wait.exe)
   (run ./test_logs.exe)
   (run ./test_status.exe)
   (run ./test_list.exe)
   (run ./test_gc.exe)
   (run ./test_gc_explicit.exe)
   (run ./test_pctl_no_gc.exe)
   (run ./test_depends_on_wait.exe)
   ; Last two: these daemon-reexec a manager. Which one, and what that
   ; costs the developer's session, is in test/e2e/reexec.ml's header.
   (run ./test_unit_state_survives_reexec.exe)
   (run ./test_reload_survives_reexec.exe))))
