; Install — unit-file install path.
;
; Writes rendered service + slice units + pctl-runtime.conf drop-ins
; into $XDG_RUNTIME_DIR/systemd/user.control/. Also computes the
; manifest (unit_filename -> sha256 hex) for persistence.
;
; Depends on `render` for spec -> unit bytes and on `schema` for types.
; `digestif.c` supplies SHA-256.
(library
 (name install)
 (public_name pctl.install)
 (libraries schema render digestif digestif.c unix))
